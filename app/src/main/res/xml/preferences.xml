<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:icon="@drawable/ic_bug"
        android:key="view_logs"
        android:title="@string/pref_view_logs_title" />

    <EditTextPreference
        android:defaultValue="30"
        android:inputType="number"
        android:key="scan_timeout"
        android:title="@string/pref_scan_timeout_title"
        app:useSimpleSummaryProvider="true" />

    <EditTextPreference
        android:inputType="text"
        android:key="device_name"
        android:title="@string/pref_device_name_title" />

    <Preference
        android:key="qq_group"
        android:summary="@string/pref_qq_group_summary"
        android:title="@string/pref_qq_group_title" />

    <Preference
        android:key="contact_dev"
        android:summary="@string/pref_contact_dev_summary"
        android:title="@string/pref_contact_dev_title" />


    <Preference
        android:key="version"
        android:selectable="false"
        android:title="@string/pref_version_title" />
</PreferenceScreen>
