<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvManualTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manual_device_dialog_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/manual_host_hint"
        android:inputType="text" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/manual_port_hint"
        android:inputType="number" />

    <LinearLayout
        android:id="@+id/layoutIpPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnIpPreset1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:text="@string/preset_ip_192_168_1"
            android:textColor="?android:attr/textColorLink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnIpPreset2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:padding="8dp"
            android:text="@string/preset_ip_192_168_0"
            android:textColor="?android:attr/textColorLink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnIpPreset3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/preset_ip_10_0_0"
            android:textColor="?android:attr/textColorLink"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
