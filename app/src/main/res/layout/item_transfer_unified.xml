<?xml version="1.0" encoding="utf-8"?>
<!-- 统一传输项布局，三处复用：设备传输子项 / 传输历史 / 设备任务弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- 状态圆点 -->
    <View
        android:id="@+id/vTransferStatus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp" />

    <!-- 文字区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 文件名 + 百分比同行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTransferName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTransferSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 进度条（仅传输子项使用） -->
        <ProgressBar
            android:id="@+id/progressTransfer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- 元信息行：状态 · 设备 · 大小 · 时间（历史/任务弹窗使用） -->
        <LinearLayout
            android:id="@+id/layoutMetaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTransferMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCheckMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="✓"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:id="@+id/vErrorDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_red"
                android:visibility="gone" />

            <View
                android:id="@+id/vOutdateDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_gray"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
