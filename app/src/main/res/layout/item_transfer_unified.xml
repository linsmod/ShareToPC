<?xml version="1.0" encoding="utf-8"?>
<!-- 统一传输项布局，三处复用：设备传输子项 / 传输历史 / 设备任务弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- 状态圆点 -->
    <View
        android:id="@+id/vTransferStatus"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp" />

    <!-- 多选勾选框（仅历史记录多选模式使用） -->
    <CheckBox
        android:id="@+id/cbTransferSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 文字区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 文件名 + 百分比同行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTransferName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvTransferPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 进度条（仅传输子项使用） -->
        <ProgressBar
            android:id="@+id/progressTransfer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <!-- 元信息行：状态 · 设备 · 大小 · 时间（历史/任务弹窗使用） -->
        <TextView
            android:id="@+id/tvTransferMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 操作按钮区 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 暂停按钮（图标） -->
        <ImageButton
            android:id="@+id/btnTransferPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_pause"
            android:src="@android:drawable/ic_media_pause"
            android:tint="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- 取消按钮（图标） -->
        <ImageButton
            android:id="@+id/btnTransferCancel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel_transfer"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="?attr/colorError"
            android:visibility="gone" />

        <!-- 操作按钮（文本按钮：重试/发送/继续） -->
        <Button
            android:id="@+id/btnTransferResume"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
