<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="搜索位置"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgBuiltinPaths"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleLine="false" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgDrives"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleLine="false" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="匹配选项"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swMatchCase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="区分大小写" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swWholeWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="全字匹配" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swMatchPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="匹配路径" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swRegex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正则表达式" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="排序方式（点击切换升序/降序）"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 行 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSortName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="文件名" />

            <TextView
                android:id="@+id/tvSortSize"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="大小" />

            <TextView
                android:id="@+id/tvSortPath"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="路径" />

        </LinearLayout>

        <!-- 行 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSortExt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="扩展名" />

            <TextView
                android:id="@+id/tvSortDateMod"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="修改日期" />

            <TextView
                android:id="@+id/tvSortDateCre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="创建日期" />

        </LinearLayout>

    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="应用筛选" />

</LinearLayout>
